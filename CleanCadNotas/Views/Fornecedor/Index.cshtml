@using ApplicationCore.Common
@{
    ViewData["Title"] = "Fornecedor";
}

<form id="fornecedorForm">
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Fornecedor</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex flex-column align-items-center">
                <div class="row w-100 mb-3">
                    <div class="card-header border bg-secondary text-white">
                        <label class="col-form-label ms-4 fw-bold">Dados da Empresa</label>
                    </div>
                    <div class="card-body border">
                        <div class="row mt-2 mb-2">
                            <label for="Social" class="col-2 col-form-label text-end fw-bold">Razão Social:</label>
                            <div class="col-7">
                                <input type="hidden" id="fornecedorId" name="Id">
                                    <input type="hidden" id="idempotencyKey" name="IdempotencyKey">
                                <input class="form-control" id="Social" name="Fornecedor">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="Fantasia" class="col-2 col-form-label text-end fw-bold">Nome Fantasia:</label>
                            <div class="col-6">
                                <input class="form-control" id="Fantasia" name="Fantasia">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="Contato" class="col-2 col-form-label text-end fw-bold">Contato:</label>
                            <div class="col-3">
                                <input class="form-control" id="Contato" name="Contato">
                            </div>
                            <label for="Estadual" class="col-2 col-form-label text-end fw-bold">Inscrição Estadual:</label>
                            <div class="col-3">
                                <input class="form-control" id="Estadual" name="IE">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="CNPJ" class="col-2 col-form-label text-end fw-bold">CNPJ:</label>
                            <div class="col-4">
                                <input class="form-control" id="CNPJ" name="CNPJ">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row w-100 mb-3">
                    <div class="card-header border bg-secondary text-white">
                        <label class="col-form-label ms-4 fw-bold">Contato</label>
                    </div>
                    <div class="card-body border">
                        <div class="row mb-2 mt-2">
                            <label for="Rua" class="col-2 col-form-label text-end fw-bold">Rua:</label>
                            <div class="col-7">
                                <input class="form-control" id="Rua" name="Rua">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="Numero" class="col-2 col-form-label text-end fw-bold">Numero:</label>
                            <div class="col-2">
                                <input class="form-control" id="Numero" name="Numero">
                            </div>
                            <label for="Bairro" class="col-2 col-form-label text-end fw-bold">Bairro:</label>
                            <div class="col-4">
                                <input class="form-control" id="Bairro" name="Bairro">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="CEP" class="col-2 col-form-label text-end fw-bold">CEP:</label>
                            <div class="col-3">
                                <input class="form-control" id="CEP" name="Cep">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="UF" class="col-2 col-form-label text-end fw-bold">UF:</label>
                            <div class="col-3">
                                <select class="form-select" id="ddlEstado" name="IdEstado">
                                    <option value="0" selected>Selecione...</option>
                                    @if (ViewBag.StateList != null && ViewBag.StateList.Count > 0)
                                    {
                                        @foreach (DropdownListVM value in ViewBag.StateList as IEnumerable<DropdownListVM>)
                                        {
                                            <option value="@value.Id">@value.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <label for="Cidade" class="col-2 col-form-label text-end fw-bold">Cidade:</label>
                            <div class="col-3">
                                <select class="form-select" id="ddlCidade" name="IdCidade">
                                    <option value="0" selected>Selecione...</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="UF" class="col-2 col-form-label text-end fw-bold">Tel1:</label>
                            <div class="col-3">
                                <input class="form-control" id="mail" name="Telefone1">
                            </div>
                            <label for="UF" class="col-2 col-form-label text-end fw-bold">Tel2:</label>
                            <div class="col-3">
                                <input class="form-control" id="mail" name="Telefone2">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="mail" class="col-2 col-form-label text-end fw-bold">E-mail:</label>
                            <div class="col-4">
                                <input class="form-control" id="mail" name="EMail">
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label for="HomePage" class="col-2 col-form-label text-end fw-bold">HomePage:</label>
                            <div class="col-4">
                                <input class="form-control" id="HomePage" name="HomePage">
                            </div>
                        </div>
                    </div>
                </div>

  
            </div>

            <div class="modal-footer">
                <button data-action="Insert" type="submit" id="submitBtn" class="btn btn-primary">Salvar</button>
            </div>
        </div>
    </div>
</div>
</form>


<form method="get" id="searchForm">
    <div class="container">
        <div class="row mb-2">
            <label for="Filtro" class="col-3 col-form-label text-end LabelName">Filtro:</label>
            <div class="col-4">
                <input class="form-control" id="Filtro" name="Filter">
            </div>
        </div>
        <div class="row mb-2 d-flex align-items-center">
            <label for="Registro" class="col-3 col-form-label text-end LabelName">Registro:</label>
            <div class="col-4">
                <input class="form-check-input" type="checkbox" id="Registro" name="Ativo" checked>
            </div>
        </div>

        <div class="row mb-2 d-flex align-items-center">
            <label class="col-3"></label> 
            <div class="col-4 d-flex justify-content-start">
                <button type="submit" class="btn ButtonOutline me-2 d-flex justify-content-center align-content-center ShowSearchAnimation"><img src="~/images/search.svg" class="SwitchingIcons" /> &nbsp;Buscar</button>
                <button type="button" id="btnNewInsert" class="btn ButtonOutline d-flex justify-content-center align-content-center" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    <img src="~/images/plus-lg.svg" class="SwitchingIcons" /> &nbsp;Novo
                </button>
            </div>
        </div>
    </div>
</form>


<div class="container">
    <div class="row mb-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Fornecedor</th>
                    <th class="text-center align-middle">Nome Fantasia</th>
                    <th class="text-center align-middle">Insc.Estadual</th>
                    <th class="text-center align-middle">CNPJ</th>
                    <th class="text-center align-middle">E-mail</th>
                    <th class="text-center align-middle"></th>
                </tr>
            </thead>
            <tbody id="tableBody">
       @*          @foreach (CadFornecedor value in ViewBag.FornecedorListTable as IPagedList<CadFornecedor>)
                {
                    <tr>
                        <td class="LongDetail">@value.Fornecedor</td>
                        <td>@value.Fantasia</td>
                        <td>@value.IE</td>
                        <td>@value.CNPJ</td>
                        <td>@value.EMail</td>
                        <td>   <a class="btn btn-info d-flex align-items-center justify-content-center" asp-action="GetFornecedorId" asp-route-id="@value.Id"><img src="~/images/pencil-fill.svg" class="SwitchingIcons" /></a> </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
</div>
<nav class="pageNav">
    <ul class="pagination justify-content-center" id="paginationControls">
    </ul>
</nav>



<script src="~/js/fornecedor.js"></script>