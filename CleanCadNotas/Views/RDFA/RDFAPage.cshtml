@using ApplicationCore.CadNotasCore.CLVMs.VMs
@{
    ViewData["Title"] = "CadRDFA";
}


<form asp-action="InsertRDFA" method="post">
    <div class="modal fade" id="InsertRDFAModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">RDFA</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="row w-100 mb-3">
                        <div class="row mb-3">
                            <label for="Item" class="col-2 col-form-label text-end fw-bold">Item:</label>
                            <div class="col-8">
                                <label class="col-form-label text-end fw-bold" id="ItemHolder"></label>
                            @*     <input type="hidden" name="selectedIds" id="selectedIds"> *@

 @*                                <input class="form-control" type="hidden" name="IdLVM" value="@ViewBag?.ValueOfLVM?.Id">
                                <input class="form-control" type="hidden" name="MascaraLVM" value="@ViewBag?.ValueOfLVM?.MascaraLVM"> *@
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="PO" class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Nº RDFA:</label>
                            <div class="col-2">
                                <input class="form-control digitsonly" id="NoRDFA" name="NoRDFA" value="@(!string.IsNullOrEmpty(ViewBag.NoRDFAValue) ? ViewBag.NoRDFAValue : ViewBag.InsertData?.NoRDFA)" @(!string.IsNullOrEmpty(ViewBag.NoRDFAValue) || ViewBag.InsertData?.FirstPost == false ? "disabled" : "")>
                                @if (!string.IsNullOrEmpty(ViewBag.NoRDFAValue))
                                {
                                    <input class="form-control" type="hidden" name="NoRDFA" value="@ViewBag.NoRDFAValue">
                                    <input class="form-control" type="hidden" name="FirstPost" value="False">
                                }
                                else
                                {
                                    <input class="form-control" type="hidden" name="FirstPost" value="true">
                                }
                                @* <input class="form-control" type="hidden" name="NoRDFA" value="@ViewBag.NoRDFAValue"> *@
                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Nº Pendência: </label>
                            <div class="col-2">
                                <input class="form-control digitsonly" id="NoPendencia" name="NoPendencia" value="@(ViewBag.NoPendenciaValue != null ? ViewBag.NoPendenciaValue : ViewBag.InsertData?.NoPendencia)" @(ViewBag.NoPendenciaValue != null ? "disabled" : "")>
                                @if (ViewBag.NoPendenciaValue != null)
                                {
                                    <input class="form-control" type="hidden" name="NoPendencia" value="@ViewBag.NoPendenciaValue">
                                }

                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel"> </label>
                            <div class="col-2">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="PO" class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Tipo de Pendência:</label>
                            <div class="col-2">
                                <select class="form-select" aria-label="Default select example" name="TipoPendencia" id="TipoPendencia">
                                    <option value="0" selected>Selecionar...</option>
                                    <option value="1">Impeditiva</option>
                                    <option value="2">Não Impeditiva</option>
                                </select>
                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Falta Documental: </label>
                            <div class="col-2">
                                <select class="form-select" aria-label="Default select example" name="FaltaDocumental" id="FaltaDocumental">
                                    <option value="0" selected>Selecionar...</option>
                                    <option value="1">Divergencia</option>
                                    <option value="2">Falta</option>
                                    <option value="3">N/A</option>
                                </select>
                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel"> Falta Física: </label>
                            <div class="col-2">
                                <select class="form-select" aria-label="Default select example" name="FaltaFisica" id="FaltaFisica">
                                    <option value="0" selected>Selecionar...</option>
                                    <option value="1">Divergencia</option>
                                    <option value="2">Avariado</option>
                                    <option value="3">Falta</option>
                                    <option value="4">N/A</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="PO" class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Data Inspeção:</label>
                            <div class="col-2">
                                <input class="form-control" type="date" id="DtInspecao" name="DtInspecao"
                                       value="@(ViewBag.InsertData?.DtInspecao != null ? ((DateTime)ViewBag.InsertData?.DtInspecao).ToString("yyyy-MM-dd") : "")">
                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel"> Status: </label>
                            <div class="col-2">
                                @*    <select class="form-select" name="RDFAStatus" id="RDFAStatus" disabled>
                                    <option value="2" selected>Reprovado</option>
                                </select> *@
                                <label class="col-2 col-form-label text-end fw-bold"> REPROVADO </label>
                                <input class="form-control" type="hidden" name="RDFAStatus" value="2">
                            </div>
                            <label class="col-2 col-form-label text-end fw-bold ObligatoryLabel"> </label>
                            <div class="col-2">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="row mt-2 mb-2">
                                <label for="Pendencia" class="col-2 col-form-label text-end fw-bold ObligatoryLabel">Pendências::</label>
                                <div class="col-10">
                                    <textarea class="form-control" id="Pendencia" rows="2" name="Pendencia">@ViewBag.InsertData?.Pendencia</textarea>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="InsertRDFASave">Salvar RDFA</button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (ViewBag.LVM != null)
{
    NotaFiscaisCLVM? values = ViewBag.LVM as NotaFiscaisCLVM;
    <div class="container">
        <div class="row w-100 mb-3">
            <div class="card-body border">
                <div class="card-header border bg-secondary text-white">
                    <label class="col-form-label ms-4 fw-bold">Contrato</label>
                </div>
                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Centro de Custo:</label>
                    <div class="col-4">
                        <label class="col-form-label text-end fw-bold">@values?.Obra</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row w-100 mb-3">
            <div class="card-body border">
                <div class="card-header border bg-secondary text-white">
                    <label class="col-form-label ms-4 fw-bold">Dados da Nota</label>
                    <input type="hidden" id="idempotencyKeyProcedimento" name="IdempotencyKey" value="@ViewBag.IdempotencyKey">
                    <input class="form-control" type="hidden" name="Id" value="@values?.Id">
                    <input class="form-control" type="hidden" id="IdLVM" name="IdLVM" value="@values?.Id">
                    <input class="form-control" type="hidden" id="CodObra" name="CodObra" value="@values?.IdObra">
                    <input class="form-control" type="hidden" id="LVMOrigem" name="LVMOrigem" value="@values?.MascaraLVM">
                </div>
                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Máscara:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.MascaraLVM</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Nº LVM:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.NLVM</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold"></label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold"></label>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Nota Fiscal:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.NotaFiscal</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Data:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.DataString</label>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Fornecedor:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.Fornecedor</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">OC:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.OC</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Invoice:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.Invoice</label>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">QtdeItens:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.QtdItem</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Material:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.Material</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Transportadora:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.Transportadora </label>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Disciplina:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.Disciplina</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold"> Tipo de OC:</label>
                    <div class="col-2">
                        <label class="col-form-label text-end fw-bold">@values?.TipoOC</label>
                    </div>
                    <label class="col-2 col-form-label text-end fw-bold">Procedimento:</label>
                </div>
                <div class="row mt-2 mb-2">
                    <label class="col-2 col-form-label text-end fw-bold">Obs:</label>
                    <div class="col-8">
                        <label class="col-form-label text-end fw-bold">@values?.Obs </label>
                    </div>
                </div>

            </div>
        </div>
        <div class="row w-100 mb-3">
            <div class="d-flex justify-content-start align-items-start">
            </div>
        </div>
    </div>
}

@if (ViewBag?.CLVMs != null)
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="row mb-3">
                <div class="col-2">
                    <input type="text" class="col-2 form-control" id="searchByItem" placeholder="Pesquisa Item">
                </div>
                <div class="col-2">
                    <input type="text" class="col-2 form-control" id="searchByCodigo" placeholder="Pesquisa Codigo">
                </div>
            </div>
            <div class="table-responsive h-50" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-hover" id="CLVMTableList">
                    <thead>
                        <tr>
                            <th class="text-center align-middle" style="width: 20px;"> <input class="form-check-input checkAll" type="checkbox" id="checkAllBoxes"></th>
                            <th class="text-center align-middle">Item</th>
                            <th class="text-center align-middle">Nota Fiscal</th>
                            <th class="text-center align-middle sap-code">Codigo e Tipo Componente</th>
                            <th class="text-center align-middle">Certificacao</th>
                            <th class="text-center align-middle">Corrida-Volume</th>
                            <th class="text-center align-middle">Qtd.</th>
                            <th class="text-center align-middle">Unid. Medida</th>
                            <th class="text-center align-middle">LVM Origem</th>
                            <th class="text-center align-middle">Programação</th>
                            <th class="text-center align-middle">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CLVMVM? value in ViewBag.CLVMs as IEnumerable<CLVMVM>)
                        {
                            <tr>
                                <td>  <input class="form-check-input clvmBox" type="checkbox" value="@value.Id" id="flexCheckDefault"> </td>
                                <td class="CLVMTable">@value.Item</td>
                                <td class="NotaFsical"></td>
                                <td class="CodigoTipo">@value?.Codigo</td>
                                <td>@value?.Certificacao</td>
                                <td>@value?.Corrida</td>
                                <td>@value?.Qtd</td>
                                <td>@value?.UnidadeMedida</td>
                                <td>@value?.LVMOrigem</td>
                                <td>@value?.Programacao</td>
                                <td>
                                    @value?.Status
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

