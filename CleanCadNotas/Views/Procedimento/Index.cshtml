@using ApplicationCore.Common
@{
    ViewData["Title"] = "Procedimento";
}

<form id="modalForm">
    <div class="modal fade" id="InsertProcedimentoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Inserir Procedimento</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex flex-column align-items-center">
                    <div class="row w-100 mb-3">

                        <div class="card-body border">
                            <div class="row mt-2 mb-2">
                                <label for="Material" class="col-2 col-form-label text-end fw-bold">Centro de Custo:</label>
                                <div class="col-4">
                                    <input type="hidden" id="Id" name="Id">
                                    <input type="hidden" id="idempotencyKey" name="IdempotencyKey">
                                    <select class="form-select" id="ddlObra" name="IdObra">
                                        <option value="0" selected>Selecione...</option>
                                        @if (ViewBag.ObraList != null && ViewBag.ObraList.Count > 0)
                                        {
                                            @foreach (DropdownListVM value in ViewBag.ObraList as IEnumerable<DropdownListVM>)
                                            {
                                                <option value="@value.Id">@value.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Procedimento" class="col-2 col-form-label text-end fw-bold">Procedimento:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Procedimento" name="Procedimento">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Revisao" class="col-2 col-form-label text-end fw-bold">Revisao:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Revisao" name="Revisao">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="get" id="searchForm">
    <div class="container">
        <div class="row mb-2">
            <label for="Filtro" class="col-3 col-form-label text-end LabelName">Filtro:</label>
            <div class="col-4">
                <input class="form-control" id="Filtro" name="Filter">
            </div>
        </div>
        <div class="row mb-2 d-flex align-items-center">
            <label for="Registro" class="col-3 col-form-label text-end LabelName">Registro:</label>
            <div class="col-4">
                <input class="form-check-input" type="checkbox" id="Registro" name="Ativo" checked>
            </div>
        </div>

        <div class="row mb-2 d-flex align-items-center">
            <label class="col-3"></label> 
            <div class="col-4 d-flex justify-content-start">
                <button type="submit" class="btn ButtonOutline me-2 d-flex justify-content-center align-content-center ShowSearchAnimation"><img src="~/images/search.svg" class="SwitchingIcons" /> &nbsp;Buscar</button>
                <button id="btnNewInsert" type="button" class="btn ButtonOutline d-flex justify-content-center align-content-center" data-bs-toggle="modal" data-bs-target="#InsertProcedimentoModal">
                    <img src="~/images/plus-lg.svg" class="SwitchingIcons" /> &nbsp;Novo
                </button>
            </div>
        </div>
    </div>
</form>

<div class="container">
    <div class="row mb-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Centro de Custo</th>
                    <th class="text-center align-middle">Procedimento</th>
                    <th class="text-center align-middle">Revisao</th>
                    <th class="text-center align-middle" style="width: 20px;"></th>
                </tr>
            </thead>
            <tbody id="tableBody">
            </tbody>
        </table>
    </div>
</div>

<nav class="pageNav">
    <ul class="pagination justify-content-center" id="paginationControls">
    </ul>
</nav>

<script src="~/js/procedimento.js"></script>