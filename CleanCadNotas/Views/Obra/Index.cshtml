@{
    ViewData["Title"] = "Centro de Custo";
}


<form id="modalForm">
    <div class="modal fade" id="InsertObraModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Inserir Obra</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex flex-column align-items-center">
                    <div class="row w-100 mb-3">

                        <div class="card-body border">
                            <div class="row mt-2 mb-2">
                                <label for="Obra" class="col-2 col-form-label text-end fw-bold">Centro de Custo:</label>
                                <div class="col-4">
                                    <input type="hidden" id="transportadoraId" name="Id">
                                    <input type="hidden" id="idempotencyKey" name="IdempotencyKey">
                                    <input class="form-control" id="Obra" name="Obra">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Cliente" class="col-2 col-form-label text-end fw-bold">Cliente:</label>
                                <div class="col-5">
                                    <input class="form-control" id="Cliente" name="Cliente">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Contrato" class="col-2 col-form-label text-end fw-bold">Contrato:</label>
                                <div class="col-5">
                                    <input class="form-control" id="Contrato" name="Contrato">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Descricao" class="col-2 col-form-label text-end fw-bold">Descricao:</label>
                                <div class="col-6">
                                    <input class="form-control" id="Descricao" name="Descricao">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2 d-flex align-items-center">
                                <label for="Objetivo" class="col-2 col-form-label text-end fw-bold">Objetivo:</label>
                                <div class="col-7">
                                    <input class="form-check-input" type="checkbox" id="Objetivo" name="Transferencia">
                                </div>
                            </div>

                        </div>
                    </div>


                </div>

                <div class="modal-footer">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="get" id="searchForm">
    <div class="container">
        <div class="row mb-2">
            <label for="Filtro" class="col-3 col-form-label text-end LabelName">Filtro:</label>
            <div class="col-4">
                <input class="form-control" id="Filtro" name="Filter">
            </div>
        </div>
        <div class="row mb-2 d-flex align-items-center">
            <label for="Registro" class="col-3 col-form-label text-end LabelName">Registro:</label>
            <div class="col-4">
                <input class="form-check-input" type="checkbox" id="Registro" name="Ativo" checked>
            </div>
        </div>

        <div class="row mb-2 d-flex align-items-center">
            <label class="col-3"></label>
            <div class="col-4 d-flex justify-content-start">
                <button type="submit" class="btn ButtonOutline me-2 d-flex justify-content-center align-content-center ShowSearchAnimation"><img src="~/images/search.svg" class="SwitchingIcons" /> &nbsp;Buscar</button>
                <button type="button" id="btnNewInsert" class="btn ButtonOutline d-flex justify-content-center align-content-center" data-bs-toggle="modal" data-bs-target="#InsertObraModal">
                    <img src="~/images/plus-lg.svg" class="SwitchingIcons" /> &nbsp;Novo
                </button>
            </div>
        </div>
    </div>
</form>

<div class="container">
    <div class="row mb-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Centro de Custo</th>
                    <th class="text-center align-middle">Cliente</th>
                    <th class="text-center align-middle">Descricao</th>
                    <th class="text-center align-middle">Contrato</th>
                    <th class="text-center align-middle"></th>
                </tr>
            </thead>
            <tbody id="tableBody">
    @*             @foreach (CadObra value in ViewBag.CentroDeCustoList as IPagedList<CadObra>)
                {
                    <tr>
                        <td>@value.Obra</td>
                        <td>@value.Cliente</td>
