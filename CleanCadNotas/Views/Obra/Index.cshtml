                        <td>@value.Contrato</td>
                        <td>   <a class="btn btn-info d-flex align-items-center justify-content-center" asp-action="GetObraId" asp-route-id="@value.Id"><img src="~/images/pencil-fill.svg" class="SwitchingIcons" /></a> </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
</div>

<nav class="pageNav">
    <ul class="pagination justify-content-center" id="paginationControls">
    </ul>
</nav>



<script src="~/js/obra.js"></script>