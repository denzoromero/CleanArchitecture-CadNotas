
<div class="custom-row parent-head">
    <div class="logo">
        <img src="/images/Logo_BrasFELS.png" style="max-width: 100%; height: auto;" />
    </div>
    <div class="custom-container">
        <div class="LVMHeader">
            <div style="font-weight: bold; font-size: 12px;">
                LISTA DE VERIFICAÇÂO DE MATERIAL
            </div>
            <div class="translation">
                Material List Verification
            </div>
        </div>
        <div style="padding: 10px;">
            <span class="fontmain"> Client </span>/ <span class="translation">Client</span>: <span style="font-size: 12px;"> @ViewBag?.HeaderValue?.Client </span>
        </div>
    </div>
    <div class="flex-container">
        <div class="first-div">
            <span style="margin-left:7px; font-weight:bold; font-size: 12px;">LVM No:</span> &nbsp; @ViewBag?.HeaderValue?.NLVM
        </div>
        <div class="second-div" style="height: 30%;">
            <span class="fontmain" style="margin-left:7px; font-size: 12px;"> DATA </span>/ <span class="translation">Date</span>:&nbsp; <span style="font-size: 12px;">  @ViewBag?.HeaderValue?.Date </span>
        </div>
    </div>
    <div class="sheet-container">
        <div class="sheetheader">
            <span class="fontmain" style="margin-left:7px;"> FOLHA </span>/ <span class="translation">Sheet</span>
        </div>
        <div class="sheetvalue">
            <span style="font-size: 12px; margin-top: 5px;" class="page-number"> {page_number} de {total_pages}</span>
        </div>
    </div>
</div>


<div class="custom-row">
    <div class="custom-col2">
        <span class="fontmain" style="margin-left:4px;"> CONTRATO </span>/ <span class="translation">Contract:</span> <span style="font-size: 12px;"> @ViewBag?.HeaderValue?.Contract </span>
    </div>
    <div class="custom-col2">
        <span class="fontmain" style="margin-left:4px;"> PROCEDIMENTO </span>/ <span class="translation">Procedure:</span> <span style="font-size: 12px;"> @ViewBag?.HeaderValue?.Procedure </span>
    </div>
    <div class="custom-col" style="text-align: center;">
        <span style="font-size: 12px;"> REV @ViewBag?.HeaderValue?.REV </span>
    </div>
</div>
<div class="custom-row">
    <div class="custom-col" style="text-align:center;">
        <span class="fontmain" style="margin-left:4px;"> DADOS CONFERIDOS NO RECEBIMENTO </span>/ <span class="translation">Data checked on receipt</span>
        (<span class="fontmain" style="margin-left:4px;">ALMOXARIFADO </span>/ <span class="translation">Warehouse</span>)
    </div>
</div>
<div class="custom-row">
    <div class="custom-col3">
        <span class="fontmain" style="margin-left:4px;"> FORNECEDOR </span>/ <span class="translation">Supplier:</span>  <span style="font-size: 12px;">  @ViewBag?.HeaderValue?.Fornecedor </span>
    </div>
    <div class="custom-col2">
        <span class="fontmain" style="margin-left:4px;"> ORDEM DE COMPRA </span>/ <span class="translation">Purchase Order:</span>  <span style="font-size: 12px;"> @ViewBag?.HeaderValue?.PO </span>
    </div>
</div>
<div class="custom-row">
    <div class="custom-col">
        <span class="fontmain" style="margin-left:4px;"> N.F/D.I: </span>  <span style="font-size: 12px;"> @ViewBag?.HeaderValue?.NotaFiscal </span>
    </div>
    <div class="custom-col">
        <span class="fontmain" style="margin-left:4px;"> No PUNCH LIST (RDFA)  @ViewBag?.HeaderValue?.NoRDFA </span>
    </div>
</div>
<div class="custom-row">
    <div class="custom-col">
        <span class="fontmain" style="margin-left:4px;"> CENTRO DE CUSTO </span>/ <span class="translation">Cost Center:</span> <span style="font-size: 12px;">  @ViewBag?.HeaderValue?.Obra  </span>
    </div>
    <div class="custom-col">
        <span class="fontmain" style="margin-left:4px;"> DISCIPLINA </span>/ <span class="translation">Discipline:</span> <span style="font-size: 12px;">  @ViewBag?.HeaderValue?.Disciplina </span>
    </div>
</div>
<div class="custom-row">
    <div class="custom-col" style="text-align:center;">
        <span class="fontmain" style="margin-left:4px;"> MATERIAL </span>
    </div>
</div>

