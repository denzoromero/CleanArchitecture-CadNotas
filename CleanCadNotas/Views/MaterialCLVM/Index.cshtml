@{
    ViewData["Title"] = "Material CLVM";
}

<form id="modalForm">
    <div class="modal fade" id="InsertMaterialCLVMModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Inserir Material CLVM</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex flex-column align-items-center">
                    <div class="row w-100 mb-3">

                        <div class="card-body border">
                            <div class="row mt-2 mb-2">
                                <label for="Codigo" class="col-2 col-form-label text-end fw-bold">Codigo:</label>
                                <div class="col-6">
                                    <input type="hidden" id="Id" name="Id">
                                    <input type="hidden" id="idempotencyKey" name="IdempotencyKey">
                                    <input class="form-control" id="Codigo" name="Codigo">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Especificacao" class="col-2 col-form-label text-end fw-bold">Especificação:</label>
                                <div class="col-5">
                                    <input class="form-control" id="Especificacao" name="Especificacao">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="TipoComponenteMaterial" class="col-2 col-form-label text-end fw-bold">Tipo Componente:</label>
                                <div class="col-4">
                                    <input class="form-control" id="TipoComponenteMaterial" name="TipoComponenteMaterial">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Descricao" class="col-2 col-form-label text-end fw-bold">Descrição:</label>
                                <div class="col-8">
                                    <textarea class="form-control" id="Descricao" rows="3" name="Descricao"></textarea>
                                </div>
                            </div>


                            <div class="row mt-2 mb-2">
                                <label for="Diametro1" class="col-2 col-form-label text-end fw-bold">Diâmetro1:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Diametro1" name="Diametro1">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Diametro2" class="col-2 col-form-label text-end fw-bold">Diâmetro2:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Diametro2" name="Diametro2">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Comprimento" class="col-2 col-form-label text-end fw-bold">Comprimento:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Comprimento" name="Comprimento">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Espessura" class="col-2 col-form-label text-end fw-bold">Espessura:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Espessura" name="Espessura">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Largura" class="col-2 col-form-label text-end fw-bold">Largura:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Largura" name="Largura">
                                </div>
                            </div>

                            <div class="row mt-2 mb-2">
                                <label for="Peso" class="col-2 col-form-label text-end fw-bold">Peso:</label>
                                <div class="col-4">
                                    <input class="form-control" id="Peso" name="Peso">
                                </div>
                            </div>


                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="get" id="searchForm">
<div class="container">
    <div class="row mb-2">
        <label for="Filtro" class="col-3 col-form-label text-end LabelName">Filtro:</label>
        <div class="col-4">
                <input class="form-control" id="Filtro" name="Filter">
        </div>
    </div>
    <div class="row mb-2 d-flex align-items-center">
        <label for="Registro" class="col-3 col-form-label text-end LabelName">Registro:</label>
        <div class="col-4">
                <input class="form-check-input" type="checkbox" id="Registro" name="Ativo" checked>
        </div>
    </div>

    <div class="row mb-2 d-flex align-items-center">
        <label class="col-3"></label> 
        <div class="col-4 d-flex justify-content-start">
            <button type="submit" class="btn ButtonOutline me-2 d-flex justify-content-center align-content-center ShowSearchAnimation"><img src="~/images/search.svg" class="SwitchingIcons" /> &nbsp;Buscar</button>
            <button type="button" id="btnNewInsert" class="btn ButtonOutline d-flex justify-content-center align-content-center" data-bs-toggle="modal" data-bs-target="#InsertMaterialCLVMModal">
                <img src="~/images/plus-lg.svg" class="SwitchingIcons" /> &nbsp;Novo
            </button>
        </div>
    </div>
</div>
</form>

<div class="container">
    <div class="row mb-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Codigo</th>
                    <th class="text-center align-middle">Especificação</th>
                    <th class="text-center align-middle">Descrição</th>
                    <th class="text-center align-middle">Diametro1</th>
                    <th class="text-center align-middle">Diametro2</th>
                    <th class="text-center align-middle">Comprimento</th>
                    <th class="text-center align-middle">Espessura</th>
                    <th class="text-center align-middle">Largura</th>
                    <th class="text-center align-middle">Peso</th>
                    <th class="text-center align-middle" style="width: 20px;"></th>
                </tr>
            </thead>
            <tbody id="tableBody">
