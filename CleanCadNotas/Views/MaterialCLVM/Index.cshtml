                        <td>@value.Peso</td>
                        <td style="width: 20px;">   <a class="btn btn-info d-flex align-items-center justify-content-center" asp-action="GetMaterialCLVMId" asp-route-id="@value.Id"><img src="~/images/pencil-fill.svg" class="SwitchingIcons" /></a> </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
</div>

<nav class="pageNav">
    <ul class="pagination justify-content-center" id="paginationControls">
    </ul>
</nav>

<script src="~/js/materialclvm.js"></script>