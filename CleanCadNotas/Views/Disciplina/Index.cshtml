@{
    ViewData["Title"] = "Disciplina";
}

<form id="modalForm">
    <div class="modal fade" id="InsertDisciplinaModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Disciplina</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex flex-column align-items-center">
                    <div class="row w-100 mb-3">

                        <div class="card-body border">
                            <div class="row mt-2 mb-2">
                                <label for="Disciplina" class="col-2 col-form-label text-end fw-bold">Disciplina:</label>
                                <div class="col-4">
                                    <input type="hidden" id="Id" name="Id">
                                    <input type="hidden" id="idempotencyKey" name="IdempotencyKey">
                                    <input class="form-control" id="Disciplina" name="Disciplina">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button id="submitBtn" type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="get" id="searchForm">
    <div class="container">
        <div class="row mb-2">
            <label for="Filtro" class="col-3 col-form-label text-end LabelName">Filtro:</label>
            <div class="col-4">
                <input class="form-control" id="Filtro" name="Filter">
            </div>
        </div>
        <div class="row mb-2 d-flex align-items-center">
            <label for="Registro" class="col-3 col-form-label text-end LabelName">Registro:</label>
            <div class="col-4">
                <input class="form-check-input" type="checkbox" id="Registro" name="Ativo" checked>
            </div>
        </div>

        <div class="row mb-2 d-flex align-items-center">
            <label class="col-3"></label> <!-- Empty label to align with previous labels -->
            <div class="col-4 d-flex justify-content-start">
                <button type="submit" class="btn ButtonOutline me-2 d-flex justify-content-center align-content-center ShowSearchAnimation"><img src="~/images/search.svg" class="SwitchingIcons" /> &nbsp;Buscar</button>
                <button type="button" id="btnNewInsert" class="btn ButtonOutline d-flex justify-content-center align-content-center" data-bs-toggle="modal" data-bs-target="#InsertDisciplinaModal">
                    <img src="~/images/plus-lg.svg" class="SwitchingIcons" /> &nbsp;Novo
                </button>
            </div>
        </div>
    </div>
</form>

<div class="container">
    <div class="row mb-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="text-center align-middle">Disciplina</th>
                    <th class="text-center align-middle" style="width: 20px;"></th>
                </tr>
            </thead>
            <tbody id="tableBody">
@*                 @foreach (CadDisciplina value in ViewBag.DisciplinaListTable as IPagedList<CadDisciplina>)
                {
                    <tr>
                        <td>@value.Disciplina</td>
                        <td style="width: 20px;">   <a class="btn btn-info d-flex align-items-center justify-content-center" asp-action="GetDisciplinaId" asp-route-id="@value.Id"><img src="~/images/pencil-fill.svg" class="SwitchingIcons" /></a> </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </div>
</div>

<nav class="pageNav">
    <ul class="pagination justify-content-center" id="paginationControls">
    </ul>
</nav>

<script src="~/js/disciplina.js"></script>